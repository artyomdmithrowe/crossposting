# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Project associated with this bot instance
PROJECT_SLUG=football

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg:///crossposting_dev

# VK community access token
VK_ACCESS_TOKEN=your_vk_community_access_token_here

# Positive VK community ID
VK_GROUP_ID=123456789

# VK API version
VK_API_VERSION=5.199

# Optional SOCKS5 proxy
# BOT_PROXY_URL=socks5://127.0.0.1:1080